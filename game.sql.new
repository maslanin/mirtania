-- ============================================================
--  NEWS
-- ============================================================
INSERT INTO `news` (`id`, `login`, `title`, `text`, `datenews`) VALUES
(1, 'maslanin', 'Игра запущена.', 'Игра запущена на сервере 256 Мб RAM, 10 Гб HDD, 2ГГц CPU (Debian 7 + nginx + php5 + mysql + memcached + eaccelerator)\r\nВисов быть не должно, но не уверен - сервер расположен в США и могут быть провалы в связи.\r\n\r\nПо игре:\r\nОбъединены в один движок абсолютно все наработки по игре.', 1406964922),
(2, 'maslanin', 'Обновление', 'Сделан баланс между шмотом / ботами / статами / мф / ценой.\r\nВсем игрокам снят шмот, так же нужно заново расставить ваши статы.', 1407584540),
(3, 'maslanin', 'Налог', 'Теперь клановый налог начисляется еще и с шахты.\r\n\r\nНапомню, что игроки не теряют ничего, налог - это дополнительные деньги, которые начисляются за полученные монеты в бою и на шахте (10% от заработанной суммы)', 1408060982),
(4, 'maslanin', 'Капча', 'В экспериментальном режиме введена новая капча, пробуем.', 1408352483),
(5, 'maslanin', 'Клановые замки', 'У кланов появилась возможность построить собственный замок.\r\n\r\nТакже в замках доступен для постройки алтарь, усиливающий игрокам их характеристики.', 1408712818),
(6, 'maslanin', 'Лог клана', 'Добавлена дворовая книга, в которой отражаются все финансовые действия внутри клана.', 1408868257),
(7, 'maslanin', 'Пивоварня', 'В замках появилась возможность построить пивоварню.', 1409051584),
(8, 'maslanin', 'Лаборатория', 'В замках доступна для постройки лаборатория.', 1409275213),
(9, 'maslanin', 'Восстановление', 'Восстановление ХП и МП увеличено.', 1409365039),
(10, 'maslanin', 'Обновления.', '1) Полностью убран срок годности с вещей\r\n2) Изменен принцип начисления опыта в бою\r\n3) Немного изменена таблица опыта', 1409891546),
(11, 'maslanin', 'Клан', 'Клан &quot;Альянс мести&quot; расформирован.', 1410072604),
(12, 'maslanin', 'Кузница', 'В клановых замках появилась возможность построить кузницу.', 1410185172),
(13, 'maslanin', 'Регистрация', 'Обнаружена и исправлена критическая ошибка, из-за которой не работала регистрация.', 1410251799),
(14, 'maslanin', 'Резерв', 'Введен резерв отдыха в 60 минут.', 1410583564),
(15, 'maslanin', 'Плащи', 'В клановых замках появилась возможность шить плащи.', 1411805022),
(16, 'maslanin', 'Небольшие изменения', 'Алтарь теперь не усиливает ваши ХП и МП.', 1412674853),
(17, 'maslanin', 'Обновления.', 'Существенно переработан бой.', 1412927376),
(18, 'maslanin', 'Обновление и оптимизация', 'Новости теперь публикуются вместе с версией игры.', 1412980552),
(19, 'maslanin', 'Восстановлена работа сервера', 'Восстановлена работа сервера после серьезного сбоя.', 1413054426),
(20, 'maslanin', 'Арена!!! И еще небольшие изменения.', 'В старый лагерь добавлена арена, тестируем!', 1413173848),
(21, 'maslanin', 'Изменения по бою', 'Параметры ботов теперь отличаются на +- 15% от базовых.', 1413371202),
(22, 'maslanin', 'Сапоги и Шлемы', 'В клановых замках появилась возможность создавать шлемы и сапоги.', 1413447501),
(23, 'maslanin', 'Грабить корованы', 'В игре появилась возможность грабить корованы.', 1413518027),
(24, 'maslanin', 'Арты и пара ошибок.', 'Сильно упрощен лог боя.', 1413715278),
(25, 'maslanin', 'Обновления.', 'На форуме добавлена возможность поставить оценку теме.', 1414064576),
(26, 'maslanin', 'Дизайн, фиксы и изменения.', 'Изменения в дизайне: топ игроков, анкета, описание оружия.', 1414302926),
(27, 'maslanin', 'Обновления.', 'Переписан чат.', 1414741723),
(28, 'maslanin', '2 уязвимости', 'Найдены и устранены 2 уязвимости.', 1415783505),
(29, 'maslanin', 'Продолжаем разработку.', 'Появилась возможность зарегистрироваться через VKontakte.', 1417423436),
(30, 'maslanin', 'Продолжаем :)', 'Переписан и оптимизирован чат.', 1417438613),
(31, 'maslanin', 'Склад', 'В банке появилась возможность хранить вещи.', 1419081258),
(32, 'maslanin', 'Поиск на рынке', 'Исправлен поиск на рынке.', 1419121504),
(33, 'maslanin', 'Обновление с вещами', 'Переписан на ООП модуль работы с вещами.', 1419569916),
(34, 'maslanin', 'В связи с наступающим', 'Отменяются квест-запреты на новогодние праздники.', 1419654080),
(35, 'maslanin', 'Лото', 'На несколько дней снижена цена на лотерейные билеты.', 1419749300),
(36, 'maslanin', 'С Новым 2015 Годом!', 'Администрация игры поздравляет вас с наступившим 2015 годом!', 1420033011),
(37, 'maslanin', 'PvP', 'В вашем профиле персонажа доступен переключатель, который позволяет включить/отключить PvP.', 1420080824),
(38, 'maslanin', 'Мини-карта', 'Небольшая доработка мини-карты.', 1421385732),
(39, 'maslanin', 'Изменения в бою', 'Несколько важных изменений в бою.', 1423013515),
(40, 'maslanin', 'Привязка VK', 'Убрана привязка VK.', 1424752841),
(41, 'maslanin', 'Форум', 'Существенно доработан форум.', 1424780283),
(42, 'maslanin', 'Контакты', 'В ПМ появилась возможность добавить нужных вам людей в контакты.', 1424860514),
(43, 'maslanin', 'Запрет на квесты', 'Убран запрет на бои/квесты.', 1425038190),
(44, 'maslanin', 'Новый этап разработки игры', 'Приглашаю всех желающих присоединиться к разработке игры.', 1425789862),
(45, 'maslanin', 'Снятие модификации', 'В игре появилась возможность с помощью точильного камня снять неудачную модификацию с вещи.', 1426137417),
(46, 'maslanin', 'Точильный камень', 'Точильный камень теперь можно выбить с тролля.', 1426198430),
(47, 'maslanin', 'Новости разведки', 'Разведка доложила, что на форпосте был замечен Дракон.', 1426934725),
(48, 'maslanin', 'Небольшая оптимизация.', 'Изменен дизайн кнопок перемещения по локации.', 1428093559),
(49, 'maslanin', 'Аренда', 'Исправлен небольшой баг с арендой.', 1433757162),
(50, 'maslanin', 'Исправлена регистрация', 'Ошибку нашел maniyax.', 1434111497),
(51, 'maslanin', 'Восстановлены кланы', 'Наконец-то нашел время и восстановил удаленные кланы.', 1436704193),
(52, 'maslanin', 'Формулы боя', 'Обновлена библиотека - формулы боя.', 1437886958),
(53, 'maslanin', 'Дизайн кнопок перемещения', 'В настройках профиля появилась возможность выбора между тремя дизайнами кнопок перемещения.', 1438411682),
(54, 'maslanin', 'Закрыта огромная дырища. ))', 'Оказывается, последние пару лет в игре был замечательный способ накрутить себе очень много монет и руды.', 1438442536),
(55, 'maslanin', 'Переезд', 'Игра переехала на новый сервер, расположенный в России.', 1438509662),
(56, 'maslanin', 'Оптимизация', 'Оптимизирован код игры.', 1438613802),
(57, 'maslanin', 'Изменения', 'Переименованы некоторые мобы.', 1443935232),
(58, 'maslanin', 'Небольшие изменения', 'Вернул ежедневный бонус в игру.', 1444045554),
(59, 'maslanin', 'Обмновление движка', 'Только что обновил движок игры.', 1444603338),
(60, 'maslanin', 'Дошли руки', 'В чате появилась торговая комната.', 1450855509),
(61, 'maslanin', 'Точильный камень', 'Добавлена возможность купить точильный камень у наковальни.', 1451118548),
(62, 'maslanin', 'С Новым годом!', 'Администрация игры сердечно поздравляет вас с наступившим 2016 годом.', 1451595625);

