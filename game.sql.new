--  ЛОКАЦИИ (loc) — 132 шт.
-- ============================================================

INSERT INTO `loc` (`id`, `map_id`, `name`, `N`, `S`, `W`, `E`, `X`, `Y`, `peace`, `info`) VALUES
(1, 1, 'Старый лагерь', 1, 1, 0, 0, 12, 8, 1, 'Старый лагерь - первый из трех оплотов людей под Магическим барьером.'),
(2, 1, 'Северные ворота', 1, 1, 0, 0, 12, 9, 0, 'На север уходит тропинка, на юге - Старый лагерь.'),
(3, 1, 'Мост', 1, 1, 1, 1, 12, 10, 0, 'На севере - развилка, на юге - Северные ворота Старого лагеря, на западе - тропинка до Нового лагеря, на востоке - тропинка до Болотного лагеря.'),
(4, 1, 'Развилка', 1, 1, 1, 1, 12, 11, 0, 'На севере - небольшая поляна, на которой охотятся стервятники, на юге - мост через реку, на запад уходит дорога на шахту, на восток - дорога к горному озеру.'),
(5, 1, 'Дорога', 0, 0, 1, 1, 13, 11, 0, 'На западе - развилка, на востоке виден поворот. Неподалеку охотятся падальщики.'),
(6, 1, 'Дорога', 1, 0, 1, 0, 14, 11, 0, 'Дорога в этом месте круто поворачивает.'),
(7, 1, 'Дорога', 1, 1, 0, 0, 14, 12, 0, 'На юге - поворот, на севере виден вход в шахту.'),
(8, 1, 'Заброшенная шахта', 0, 1, 0, 1, 14, 13, 0, 'Видно, что из шахты уже вырыли большую часть ресурсов, и теперь ее облюбовали любители сырости и пещер - кротокрысы.'),
(9, 1, 'Аванпост стражи', 1, 0, 1, 0, 15, 13, 0, 'На западе - вход в шахту, на севере - озеро, прямо над вами - дощатый настил, по которому ходят два стражника. Под ногами ползают мясные жуки.'),
(10, 1, 'Дорога', 0, 1, 0, 0, 15, 14, 0, 'Глубокое горное озеро, именно в него попадают новички после прохода через Магический барьер.'),
(11, 1, 'Поляна', 1, 1, 0, 0, 12, 12, 0, 'Небольшая поляна, на которой охотятся несколько стервятников. На юге развилка, на севере тропинка.'),
(12, 1, 'Дорога на шахту', 0, 0, 1, 1, 11, 11, 0, 'Дорога, набитая тяжело нагруженными телегами. На востоке развилка.'),
(13, 1, 'Дорога на шахту', 0, 0, 1, 1, 10, 11, 0, 'Дорога, набитая тяжело нагруженными телегами. На западе - пещера. Неподалеку жужжат шершни.'),
(14, 1, 'Пещера', 1, 0, 0, 1, 9, 11, 0, 'Дорога идет через пещеру. Из темноты на вас смотрят несколько пар зловещих глаз.'),
(15, 1, 'Развилка', 0, 1, 1, 1, 9, 12, 0, 'Дорога сужается и переходит в тропку, ведущую на запад. На востоке видна большая поляна. На юге - пещера.'),
(16, 1, 'Тропинка', 1, 0, 0, 1, 8, 12, 0, 'Тропинка изгибается и ведет на север. На востоке - развилка.'),
(17, 1, 'Тропинка', 0, 1, 1, 0, 8, 13, 0, 'На запад и на юг тянется тропинка.'),
(18, 1, 'Тропинка', 1, 0, 1, 1, 7, 13, 0, 'На севере виден вход в шахту, на запад и на восток тянется тропинка.'),
(19, 1, 'Старая шахта', 0, 1, 0, 1, 7, 14, 0, 'Несколько рудокопов увлеченно долбят руду. На юге тропинка, на востоке видна пара ползунов.'),
(20, 1, 'Поляна', 1, 0, 1, 0, 10, 12, 0, 'На западе - развилка, поляна простирается на север. Неподалеку охотятся зубастые остеры.'),
(21, 1, 'Поляна', 1, 1, 0, 0, 10, 13, 0, 'На севере видна огромная пещера, на юге - поляна. Совсем рядом, не замечая вас, скачут злобные гоблины.'),
(22, 1, 'Логово тролля', 0, 1, 0, 0, 10, 14, 0, 'На юге - поляна, вокруг отвесные скалы, на севере - пещера, всюду валяются обглоданные кости, почти все - человеческие...'),
(23, 1, 'Южные ворота', 1, 1, 0, 0, 12, 7, 0, 'Южные ворота старого лагеря. На севере сам лагерь, на юге - перекресток.'),
(24, 1, 'Перекресток', 1, 1, 1, 1, 12, 6, 0, 'На севере виден Старый лагерь. На юг и на запад уходит тропинка, на востоке - пляж.'),
(25, 1, 'Тропинка', 0, 0, 1, 1, 11, 6, 0, 'Тропинка тянется с востока на запад, на востоке - перекресток.'),
(26, 1, 'Тропинка', 0, 1, 1, 1, 10, 6, 0, 'Тропинка тянется с востока на запад, на юге - избушка, рядом с которой валяется порванная рыболовная сеть.'),
(27, 1, 'Логово глорхов', 1, 1, 0, 1, 9, 6, 0, 'В этом месте сходятся вместе три тропинки - идеальное место для засады или охоты хищникам.'),
(28, 1, 'Тропинка', 1, 1, 1, 0, 9, 7, 0, 'Тропинка тянется с севера на юг, на западе - дорога к Новому лагерю.'),
(29, 1, 'Дорога', 0, 0, 1, 1, 8, 7, 0, 'На востоке - дорога сужается и переходит в тропинку, на западе - поворот.'),
(30, 1, 'Поворот', 1, 0, 0, 1, 7, 7, 0, 'Дорога ведет на север и на восток.'),
(31, 1, 'Дорога', 0, 1, 1, 0, 7, 8, 0, 'На юге - поворот, дорога уходит на запад.'),
(32, 1, 'Дорога', 0, 0, 1, 1, 6, 8, 0, 'Хорошо протоптанная дорога ведет на запад и на восток.'),
(33, 1, 'Дорога', 1, 0, 0, 1, 5, 8, 0, 'Дорога ведет на север и на восток.'),
(34, 1, 'Дорога', 1, 1, 0, 0, 5, 9, 0, 'На севере - перекресток, на юг уходит дорога.'),
(35, 1, 'Перекресток', 0, 1, 1, 1, 5, 10, 0, 'На западе - вход в Новый лагерь, на восток уходит тропинка на Старую шахту, на юг ведет дорога до Старого лагеря.'),
(36, 1, 'Вход в Новый лагерь', 0, 0, 1, 1, 4, 10, 0, 'На западе - центр лагеря, на востоке - перекресток.'),
(37, 1, 'Новый лагерь', 1, 0, 0, 1, 3, 10, 0, 'Новый лагерь образован теми, кто не смог найти приют в Старом лагере.'),
(38, 1, 'Таверна', 1, 1, 0, 0, 3, 11, 0, 'На юге - центр лагеря, на север уходит дорога к Свободной шахте. Прямо перед вами вход в таверну - местное питейное заведение.'),
(39, 1, 'Дорога на шахту', 0, 1, 1, 0, 3, 12, 0, 'На запад ведет дорога на шахту, на юге - таверна.'),
(40, 1, 'Дорога на шахту', 0, 0, 1, 1, 2, 12, 0, 'Дорога уходит на запад и на восток.'),
(41, 1, 'Дорога на шахту', 0, 1, 0, 1, 1, 12, 0, 'Дорога идет на юг и на восток, совсем рядом вы замечаете несколько неестественных теней...'),
(42, 1, 'Дорога на шахту', 1, 1, 0, 0, 1, 11, 0, 'Дорога ведет на юг и на север.'),
(43, 1, 'Дорога на шахту', 1, 1, 0, 0, 1, 10, 0, 'Дорога ведет на север, на юге - вход в шахту.'),
(44, 1, 'Свободная шахта', 1, 0, 0, 0, 1, 9, 0, 'Рудокопы добывают руду, надзиратели следят, чтобы ни один кусочек руды не попал в чей-либо карман.'),
(45, 1, 'Тропинка', 1, 0, 1, 0, 6, 10, 0, 'На западе - перекресток, на север уходит тропинка к Старой шахте. Рядом с вами - старая наковальня и кузнечный молот.'),
(46, 1, 'Мостик', 1, 1, 0, 0, 6, 11, 0, 'На севере и на юге видна тропинка.'),
(47, 1, 'Тропинка', 1, 1, 0, 0, 6, 12, 0, 'На юге - мостик через реку, на севере - тропинка.'),
(48, 1, 'Тропинка', 0, 1, 0, 1, 6, 13, 0, 'На юг уходит тропинка к Новому лагерю, на востоке - тропинка до Старой шахты.'),
(49, 1, 'Храм орков', 0, 0, 1, 1, 6, 4, 0, 'На востоке мост, прямо перед вами - Алтарь орков. На западе открытые ворота. Похоже, там проход в Город мертвых. Рядом с алтарем в безмолвной молитве застыли несколько Орков...'),
(50, 1, 'Мост', 0, 0, 1, 1, 7, 4, 0, 'На западе - Храм орков, на востоке - тропинка.'),
(51, 1, 'Тропинка', 1, 1, 1, 0, 8, 4, 0, 'Тропинка идет по землям орков, на западе виден какой-то старый мост.'),
(52, 1, 'Тропинка', 1, 0, 0, 1, 8, 3, 0, 'Тропинка уходит на север и на восток.'),
(53, 1, 'Тропинка', 0, 1, 1, 1, 9, 3, 0, 'Тропинка ведет на запад и уходит на восток, на юге - ущелье.'),
(54, 1, 'Ущелье', 1, 0, 1, 0, 9, 2, 0, 'На севере - тропинка, ущелье тянется на запад.'),
(55, 1, 'Тропинка', 0, 0, 1, 1, 8, 2, 0, 'Ущелье тянется на запад и на восток.'),
(56, 1, 'Башня некроманта', 0, 0, 0, 1, 7, 2, 0, 'Внезапно из темноты выступила огромная башня некроманта.'),
(57, 1, 'Тропинка', 0, 1, 0, 1, 8, 5, 0, 'Тропинка тянется на юг и на восток.'),
(58, 1, 'Тропинка', 1, 0, 1, 0, 9, 5, 0, 'Тропинка тянется на север и на запад.'),
(59, 1, 'Тропинка', 1, 1, 0, 0, 12, 5, 0, 'На севере - перекресток, тропинка уходит на юг.'),
(60, 1, 'Тропинка', 1, 1, 0, 0, 12, 4, 0, 'Тропинка тянется на север и на юг.'),
(61, 1, 'Тропинка', 1, 0, 1, 1, 12, 3, 0, 'Тропинка ведет на север и на запад, на востоке - мост.'),
(62, 1, 'Мост', 0, 0, 1, 1, 13, 3, 0, 'Огромный каменный мост через реку, от него начинается дорога в виде серпантина, ведущая к строению на горе.'),
(63, 1, 'Серпантин', 0, 1, 1, 0, 14, 3, 0, 'Горная дорога ведет, петляя, вверх и вниз.'),
(64, 1, 'Серпантин', 1, 0, 1, 0, 14, 2, 0, 'Горная дорога ведет, петляя, вверх и вниз.'),
(65, 1, 'Серпантин', 0, 1, 0, 1, 13, 2, 0, 'Горная дорога ведет, петляя, вверх и вниз.'),
(66, 1, 'Серпантин', 1, 0, 0, 1, 13, 1, 0, 'В этом месте дорога упирается в старинную башню с надписью "Библиотека".'),
(67, 1, 'Библиотека', 0, 0, 1, 0, 14, 1, 0, 'Среди разваленных кучами книг устроили свои гнезда гарпии.'),
(68, 1, 'Пляж', 0, 0, 1, 1, 13, 6, 0, 'Тропинка ведет вдоль красивого пляжа на восток и на запад.'),
(69, 1, 'Пляж', 0, 0, 1, 1, 14, 6, 0, 'Тропинка ведет вдоль красивого пляжа на восток и на запад.'),
(70, 1, 'Пляж', 1, 1, 1, 0, 15, 6, 0, 'На севере тропинка уходит в лес, на западе тянется пляж, на юге - подвесной мост.'),
(71, 1, 'Подвесной мост', 1, 1, 0, 0, 15, 5, 0, 'Небольшой мост перекинут через глубокое ущелье. На юге - Костяная долина.'),
(72, 1, 'Костяная долина', 1, 0, 0, 1, 15, 4, 0, 'Долина усыпана ребрами каких-то огромных животных... На севере - мост, на востоке - пещера.'),
(73, 1, 'Пещера орков', 0, 0, 1, 0, 16, 4, 0, 'Всюду валяются человеческие кости, обломки оружия. На западе - Костяная долина.'),
(74, 1, 'Тропинка', 0, 1, 0, 1, 9, 10, 0, 'Тропинка тянется на юг и на восток.'),
(75, 1, 'Тропинка', 0, 1, 1, 1, 10, 10, 0, 'Тропинка тянется на запад и на восток, на юге - небольшой домик.'),
(76, 1, 'Тропинка', 0, 0, 1, 1, 11, 10, 0, 'Тропинка тянется на запад, на востоке виден мостик.'),
(77, 1, 'Домик', 1, 0, 0, 0, 10, 9, 0, 'Небольшой опрятный домик, везде чисто, выход на севере.'),
(78, 1, 'Тропинка', 1, 1, 0, 0, 9, 9, 0, 'Тропинка тянется на север и на юг.'),
(79, 1, 'Тропинка', 1, 1, 0, 0, 9, 8, 0, 'Тропинка тянется на север и на юг.'),
(80, 1, 'Тропинка', 0, 0, 1, 1, 13, 10, 0, 'Тропинка тянется на запад и на восток.'),
(81, 1, 'Берег', 0, 0, 1, 1, 14, 10, 0, 'Тропинка тянется вдоль берега на запад и на восток.'),
(82, 1, 'Тропинка', 0, 0, 1, 1, 15, 10, 0, 'Тропинка тянется на запад и на восток.'),
(83, 1, 'Тропинка', 0, 1, 0, 1, 15, 9, 0, 'Тропинка тянется восток. На юге - пляж.'),
(84, 1, 'Пляж', 1, 1, 0, 1, 15, 8, 0, 'Красивый пляж тянется на юг. На севере - тропинка. На востоке - лес.'),
(85, 1, 'Пляж', 1, 1, 0, 0, 15, 7, 0, 'Красивый пляж тянется на юг и на север.'),
(86, 1, 'Лес', 0, 0, 1, 1, 16, 8, 0, 'Довольно редкий лес, на западе - пляж, на востоке между деревьями мелькает еле заметная тропинка.'),
(87, 1, 'Лес', 0, 1, 1, 0, 17, 8, 0, 'Вокруг лес, на западе и юге еле заметная тропка.'),
(88, 1, 'Тропинка', 1, 1, 0, 0, 17, 7, 0, 'На севере - лес, на юге - поляна.'),
(89, 1, 'Тропинка', 1, 0, 0, 1, 17, 6, 0, 'Тропинка ведет на север. На востоке - вход в Болотный лагерь. Совсем рядом в реке плещется гигантская тварь, похожая на огромную трубу.'),
(90, 1, 'Вход в лагерь', 0, 0, 1, 1, 18, 6, 0, 'На востоке - центр лагеря и огромный Храм, на западе - тропинка.'),
(91, 1, 'Болотный лагерь', 0, 0, 1, 0, 19, 6, 0, 'Обитают в этом лагере фанатики, что неустанно молятся своему единственному богу - Спящему.'),
(92, 1, 'Тропинка', 1, 0, 1, 0, 16, 9, 0, 'Этот поворот тропинки облюбовали свирепые хищники...'),
(93, 1, 'Тропинка', 1, 1, 1, 0, 16, 10, 0, 'Тропинка ведет на запад и на юг. На севере - небольшой мостик через реку.'),
(94, 1, 'Мостик', 1, 1, 0, 1, 16, 11, 0, 'На юге - тропинка, на востоке - Башня скелетов, на севере - Форпост.'),
(95, 1, 'Башня скелетов', 0, 0, 1, 0, 17, 11, 0, 'Поговаривают, что некий некромант поднял огромную армию нежити и скелетов и до определенного момента скрыл ее в этой Башне...'),
(96, 1, 'Форпост', 0, 1, 0, 0, 16, 12, 0, 'Форпост давно разрушен, лишь руины напоминают о некогда былом величии... Неподалеку вы видите дракона.'),
(97, 1, 'Тропинка', 0, 0, 1, 1, 10, 3, 0, 'Тропинка тянется на запад и на восток.'),
(98, 1, 'Тропинка', 0, 0, 1, 1, 11, 3, 0, 'Тропинка тянется на запад и на восток.'),
(99, 1, 'Избушка', 1, 0, 0, 0, 10, 5, 0, 'На толстой дубовой лавке развалился дряхленький старичок. На севере - выход.'),
(100, 1, 'Логово ползунов', 0, 0, 1, 0, 8, 14, 0, 'На западе рудокопы машут кирками, из темноты слышны щелкания огромных челюстей ползунов.'),
(101, 1, 'Развилка', 0, 1, 1, 1, 12, 13, 0, 'Тропинка упирается в практически непроходимый лес и разветвляется на запад и восток.'),
(102, 1, 'Развилка', 1, 1, 1, 0, 13, 13, 0, 'Тропинка упирается в подножие горы и уходит на север. На юге большое гнездо.'),
(103, 1, 'Гнездо', 1, 0, 0, 0, 13, 12, 0, 'Огромное гнездо гигантского жука-шелкопряда. На севере тропинка.'),
(104, 1, 'Развилка', 0, 1, 1, 1, 13, 14, 0, 'Тропинка привела вас на берег горного озера. На востоке озеро, на западе большое дерево.'),
(105, 1, 'Берег озера', 0, 0, 1, 0, 14, 14, 0, 'Вы стоите на берегу озера, в которое когда-то попали будучи новичком. На западе - тропинка.'),
(106, 1, 'Дерево', 0, 0, 0, 1, 12, 14, 0, 'Вы стоите у подножия большого дерева с прочными гибкими ветвями. На востоке развилка.'),
(107, 1, 'Куча навоза', 0, 1, 0, 0, 11, 14, 0, 'В куче копошатся разные черви, над кучей кружат мухи и скачут кузнечики. На юге развилка.'),
(108, 1, 'Развилка', 1, 1, 0, 1, 11, 13, 0, 'На севере видно большую кучу навоза, на юге куча костей.'),
(109, 1, 'Кладбище животных', 1, 0, 0, 0, 11, 12, 0, 'Сюда дикие животные приходят умирать. Вы можете найти себе подходящую по форме кость. На севере развилка.'),
(110, 1, 'Город мертвых', 1, 0, 0, 1, 1, 1, 0, ''),
(111, 1, 'Город мертвых', 1, 1, 0, 0, 1, 2, 0, ''),
(112, 1, 'Город мертвых', 0, 1, 0, 1, 1, 3, 0, ''),
