-- ============================================================
--  МИРТАНИЯ — база данных
--  Исправленная версия для MySQL 8.0+
--  Кодировка: utf8mb4
--  Движок: InnoDB
-- ============================================================

SET NAMES utf8mb4;
SET time_zone = '+00:00';
SET sql_mode = 'NO_AUTO_VALUE_ON_ZERO';

-- ------------------------------------------------------------
--  Таблица: arena — заявки на арену
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `arena`;
CREATE TABLE `arena` (
  `id`       INT NOT NULL AUTO_INCREMENT,
  `login`    VARCHAR(255) NOT NULL DEFAULT '',
  `time`     INT NOT NULL DEFAULT 0,
  `kom1`     INT NOT NULL DEFAULT 0,
  `kom2`     INT NOT NULL DEFAULT 0,
  `minlvl1`  INT NOT NULL DEFAULT 0,
  `maxlvl1`  INT NOT NULL DEFAULT 0,
  `minlvl2`  INT NOT NULL DEFAULT 0,
  `maxlvl2`  INT NOT NULL DEFAULT 0,
  `comment`  VARCHAR(500) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`),
  KEY `idx_time` (`time`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: arenda — предложения аренды вещей
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `arenda`;
CREATE TABLE `arenda` (
  `id`           INT NOT NULL AUTO_INCREMENT,
  `idv`          INT NOT NULL DEFAULT 0,
  `ido`          INT NOT NULL DEFAULT 0,
  `cena`         INT NOT NULL DEFAULT 0,
  `srok`         INT NOT NULL DEFAULT 0,
  `time`         INT NOT NULL DEFAULT 0,
  `login`        VARCHAR(255) NOT NULL DEFAULT '',
  `arenda_login` VARCHAR(255) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`),
  KEY `idx_arenda_login` (`arenda_login`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: battle — активные бои
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `battle`;
CREATE TABLE `battle` (
  `id`        INT NOT NULL AUTO_INCREMENT,
  `flag_boi`  TINYINT NOT NULL DEFAULT 0,
  `login`     VARCHAR(255) NOT NULL DEFAULT '',
  `login2`    VARCHAR(255) NOT NULL DEFAULT '',
  `boistart`  INT NOT NULL DEFAULT 0,
  `sbrospar`  INT NOT NULL DEFAULT 0,
  `round`     INT NOT NULL DEFAULT 0,
  `krov`      INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_flag_boi` (`flag_boi`),
  KEY `idx_login` (`login`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: battlelog — лог боя
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `battlelog`;
CREATE TABLE `battlelog` (
  `id`       INT NOT NULL AUTO_INCREMENT,
  `boi_id`   INT NOT NULL DEFAULT 0,
  `timelog`  INT NOT NULL DEFAULT 0,
  `log`      TEXT NOT NULL DEFAULT (''),
  PRIMARY KEY (`id`),
  KEY `idx_boi_id` (`boi_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: chat — сообщения чата
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `chat`;
CREATE TABLE `chat` (
  `id`          INT NOT NULL AUTO_INCREMENT,
  `login`       VARCHAR(255) NOT NULL DEFAULT '',
  `message`     TEXT NOT NULL DEFAULT (''),
  `room`        TINYINT NOT NULL DEFAULT 0,
  `privat`      VARCHAR(255) NOT NULL DEFAULT '',
  `flag_privat` TINYINT NOT NULL DEFAULT 0,
  `sex`         TINYINT NOT NULL DEFAULT 0,
  `timemess`    INT NOT NULL DEFAULT 0,
  `klan`        VARCHAR(255) NOT NULL DEFAULT '',
  `party`       INT NOT NULL DEFAULT 0,
  `admin`       TINYINT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_room` (`room`),
  KEY `idx_login` (`login`),
  KEY `idx_timemess` (`timemess`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: combat — участники боя
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `combat`;
CREATE TABLE `combat` (
  `id`         INT NOT NULL AUTO_INCREMENT,
  `login`      VARCHAR(255) NOT NULL DEFAULT '',
  `sila`       INT NOT NULL DEFAULT 0,
  `inta`       INT NOT NULL DEFAULT 0,
  `lovka`      INT NOT NULL DEFAULT 0,
  `flag_bot`   TINYINT NOT NULL DEFAULT 0,
  `kuda_udar`  TINYINT NOT NULL DEFAULT 0,
  `kuda_blok`  TINYINT NOT NULL DEFAULT 0,
  `uron_boi`   INT NOT NULL DEFAULT 0,
  `lvl`        INT NOT NULL DEFAULT 0,
  `hpnow`      INT NOT NULL DEFAULT 0,
  `hpmax`      INT NOT NULL DEFAULT 0,
  `mananow`    INT NOT NULL DEFAULT 0,
  `manamax`    INT NOT NULL DEFAULT 0,
  `boi_id`     INT NOT NULL DEFAULT 0,
  `boi_round`  INT NOT NULL DEFAULT 0,
  `komanda`    TINYINT NOT NULL DEFAULT 0,
  `sopernik`   INT NOT NULL DEFAULT 0,
  `time_udar`  INT NOT NULL DEFAULT 0,
  `time`       INT NOT NULL DEFAULT 0,
  `magic_hod`  INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_boi_id` (`boi_id`),
  KEY `idx_login` (`login`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: forum_comm — комментарии форума
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `forum_comm`;
CREATE TABLE `forum_comm` (
  `id`        INT NOT NULL AUTO_INCREMENT,
  `login`     VARCHAR(255) NOT NULL DEFAULT '',
  `id_topic`  INT NOT NULL DEFAULT 0,
  `razdel`    TINYINT NOT NULL DEFAULT 0,
  `message`   TEXT NOT NULL DEFAULT (''),
  `time`      INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_id_topic` (`id_topic`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: forum_topic — темы форума
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `forum_topic`;
CREATE TABLE `forum_topic` (
  `id`         INT NOT NULL AUTO_INCREMENT,
  `login`      VARCHAR(255) NOT NULL DEFAULT '',
  `razdel`     INT NOT NULL DEFAULT 0,
  `name`       VARCHAR(255) NOT NULL DEFAULT '',
  `timetopic`  INT NOT NULL DEFAULT 0,
  `message`    TEXT NOT NULL DEFAULT (''),
  `lastcomm`   INT NOT NULL DEFAULT 0,
  `flag_close` TINYINT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_razdel` (`razdel`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: invent — инвентарь
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `invent`;
CREATE TABLE `invent` (
  `id`            INT NOT NULL AUTO_INCREMENT,
  `ido`           INT NOT NULL DEFAULT 0,
  `login`         VARCHAR(255) NOT NULL DEFAULT '',
  `flag_pered`    TINYINT NOT NULL DEFAULT 0,
  `flag_rinok`    TINYINT NOT NULL DEFAULT 0,
  `flag_equip`    TINYINT NOT NULL DEFAULT 0,
  `flag_arenda`   TINYINT NOT NULL DEFAULT 0,
  `flag_sklad`    TINYINT NOT NULL DEFAULT 0,
  `arenda_login`  VARCHAR(255) NOT NULL DEFAULT '',
  `arenda_time`   INT NOT NULL DEFAULT 0,
  `arenda_price`  INT NOT NULL DEFAULT 0,
  `rinok_price`   INT NOT NULL DEFAULT 0,
  `time`          INT NOT NULL DEFAULT 0,
  `up`            INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`),
  KEY `idx_ido` (`ido`),
  KEY `idx_flag_rinok` (`flag_rinok`),
  KEY `idx_arenda_login` (`arenda_login`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: ipsoft — логи заходов
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `ipsoft`;
CREATE TABLE `ipsoft` (
  `id`      INT NOT NULL AUTO_INCREMENT,
  `login`   VARCHAR(255) NOT NULL DEFAULT '',
  `date`    INT NOT NULL DEFAULT 0,
  `ip`      VARCHAR(64) NOT NULL DEFAULT '',
  `host`    VARCHAR(255) NOT NULL DEFAULT '',
  `soft`    VARCHAR(255) NOT NULL DEFAULT '',
  `session` VARCHAR(255) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`),
  KEY `idx_date` (`date`),
  KEY `idx_ip` (`ip`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: klans — кланы
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `klans`;
CREATE TABLE `klans` (
  `id`         INT NOT NULL AUTO_INCREMENT,
  `name`       VARCHAR(255) NOT NULL DEFAULT '',
  `datereg`    INT NOT NULL DEFAULT 0,
  `nalog_time` INT NOT NULL DEFAULT 0,
  `points`     INT NOT NULL DEFAULT 0,
  `lvl`        INT NOT NULL DEFAULT 1,
  `kazna`      INT NOT NULL DEFAULT 0,
  `point`      INT NOT NULL DEFAULT 0,
  `kamni`      INT NOT NULL DEFAULT 0,
  `loc`        INT NOT NULL DEFAULT 0,
  `altar`      INT NOT NULL DEFAULT 0,
  `pivo`       INT NOT NULL DEFAULT 0,
  `laba`       INT NOT NULL DEFAULT 0,
  `kuznica`    INT NOT NULL DEFAULT 0,
  `oruzh`      INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_name` (`name`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: klan_log — лог клана
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `klan_log`;
CREATE TABLE `klan_log` (
  `id`    INT NOT NULL AUTO_INCREMENT,
  `login` VARCHAR(255) NOT NULL DEFAULT '',
  `log`   TEXT NOT NULL DEFAULT (''),
  `klan`  VARCHAR(255) NOT NULL DEFAULT '',
  `date`  INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_klan` (`klan`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: letters — личные сообщения
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `letters`;
CREATE TABLE `letters` (
  `id`        INT NOT NULL AUTO_INCREMENT,
  `lid`       INT NOT NULL DEFAULT 0,
  `timemess`  INT NOT NULL DEFAULT 0,
  `login`     VARCHAR(255) NOT NULL DEFAULT '',
  `login_from` VARCHAR(255) NOT NULL DEFAULT '',
  `mess`      TEXT NOT NULL DEFAULT (''),
  `timeread`  INT NOT NULL DEFAULT 0,
  `read_flag` TINYINT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`),
  KEY `idx_login_from` (`login_from`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: loc — локации
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `loc`;
CREATE TABLE `loc` (
  `id`     INT NOT NULL AUTO_INCREMENT,
  `map_id` INT NOT NULL DEFAULT 0,
  `name`   VARCHAR(255) NOT NULL DEFAULT '',
  `N`      TINYINT NOT NULL DEFAULT 0,
  `S`      TINYINT NOT NULL DEFAULT 0,
  `W`      TINYINT NOT NULL DEFAULT 0,
  `E`      TINYINT NOT NULL DEFAULT 0,
  `X`      INT NOT NULL DEFAULT 0,
  `Y`      INT NOT NULL DEFAULT 0,
  `peace`  TINYINT NOT NULL DEFAULT 0,
  `info`   TEXT NOT NULL DEFAULT (''),
  PRIMARY KEY (`id`),
  KEY `idx_map_xy` (`map_id`, `X`, `Y`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: log_ipsoft — лог IP/SOFT
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `log_ipsoft`;
CREATE TABLE `log_ipsoft` (
  `id`    INT NOT NULL AUTO_INCREMENT,
  `login` VARCHAR(255) NOT NULL DEFAULT '',
  `date`  INT NOT NULL DEFAULT 0,
  `log`   TEXT NOT NULL DEFAULT (''),
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: log_peredach — лог передач
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `log_peredach`;
CREATE TABLE `log_peredach` (
  `id`         INT NOT NULL AUTO_INCREMENT,
  `login`      VARCHAR(255) NOT NULL DEFAULT '',
  `log`        TEXT NOT NULL DEFAULT (''),
  `login_per`  VARCHAR(255) NOT NULL DEFAULT '',
  `dateper`    INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`),
  KEY `idx_login_per` (`login_per`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: magic — магия
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `magic`;
CREATE TABLE `magic` (
  `id`     INT NOT NULL AUTO_INCREMENT,
  `mag_id` INT NOT NULL DEFAULT 0,
  `login`  VARCHAR(255) NOT NULL DEFAULT '',
  `name`   VARCHAR(255) NOT NULL DEFAULT '',
  `mana`   INT NOT NULL DEFAULT 0,
  `date`   INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: map — карты
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `map`;
CREATE TABLE `map` (
  `id`    INT NOT NULL AUTO_INCREMENT,
  `x`     INT NOT NULL DEFAULT 1,
  `y`     INT NOT NULL DEFAULT 1,
  `name`  VARCHAR(255) NOT NULL DEFAULT '',
  `peace` TINYINT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: news — новости
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `news`;
CREATE TABLE `news` (
  `id`       INT NOT NULL AUTO_INCREMENT,
  `login`    VARCHAR(255) NOT NULL DEFAULT '',
  `title`    VARCHAR(255) NOT NULL DEFAULT '',
  `text`     TEXT NOT NULL DEFAULT (''),
  `datenews` INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: recpass — восстановление пароля
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `recpass`;
CREATE TABLE `recpass` (
  `id`      INT NOT NULL AUTO_INCREMENT,
  `email`   VARCHAR(255) NOT NULL DEFAULT '',
  `code`    VARCHAR(255) NOT NULL DEFAULT '',
  `daterec` INT NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_email` (`email`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
--  Таблица: settings — настройки
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `settings`;
CREATE TABLE `settings` (
  `id`    INT NOT NULL AUTO_INCREMENT,
  `name`  VARCHAR(255) NOT NULL DEFAULT '',
  `bot`   VARCHAR(255) NOT NULL DEFAULT '',
  `admin` VARCHAR(255) NOT NULL DEFAULT '',
  `reg`   TINYINT NOT NULL DEFAULT 1,
  `mess`  VARCHAR(500) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

INSERT INTO `settings` VALUES (1, 'Миртания', 'system', 'maslanin', 1, '');

-- ------------------------------------------------------------
--  Таблица: users — персонажи
-- ------------------------------------------------------------
DROP TABLE IF EXISTS `users`;
CREATE TABLE `users` (
  `id`           INT NOT NULL AUTO_INCREMENT,
  `login`        VARCHAR(255) NOT NULL DEFAULT '',
  `email`        VARCHAR(255) NOT NULL DEFAULT '',
  `pass`         VARCHAR(255) NOT NULL DEFAULT '',
  `name`         VARCHAR(255) NOT NULL DEFAULT '',
  `infa`         VARCHAR(500) NOT NULL DEFAULT '',
  `brak`         VARCHAR(255) NOT NULL DEFAULT '',
  `ignor`        TEXT NOT NULL DEFAULT (''),
  `kont`         TEXT NOT NULL DEFAULT (''),
  `sex`          TINYINT NOT NULL DEFAULT 0,
  `lvl`          INT NOT NULL DEFAULT 1,
  `loc`          INT NOT NULL DEFAULT 1,
  `lastportal`   INT NOT NULL DEFAULT 0,
  `host`         VARCHAR(255) NOT NULL DEFAULT '',
  `ip`           VARCHAR(64) NOT NULL DEFAULT '',
  `soft`         VARCHAR(255) NOT NULL DEFAULT '',
  `session`      VARCHAR(255) NOT NULL DEFAULT '',
  `flag_blok`    TINYINT NOT NULL DEFAULT 0,
  `zachto_blok`  VARCHAR(500) NOT NULL DEFAULT '',
  `ban`          INT NOT NULL DEFAULT 0,
  `ruda`         INT NOT NULL DEFAULT 0,
  `money`        INT NOT NULL DEFAULT 0,
  `vip`          INT NOT NULL DEFAULT 0,
  `bank`         INT NOT NULL DEFAULT 0,
  `bankdate`     INT NOT NULL DEFAULT 0,
  `klan_invite`  VARCHAR(255) NOT NULL DEFAULT '',
  `klan`         VARCHAR(255) NOT NULL DEFAULT '',
  `klan_time`    INT NOT NULL DEFAULT 0,
  `klan_status`  TINYINT NOT NULL DEFAULT 0,
  `nalog`        INT NOT NULL DEFAULT 0,
  `party`        VARCHAR(255) NOT NULL DEFAULT '',
  `win`          INT NOT NULL DEFAULT 0,
  `lost`         INT NOT NULL DEFAULT 0,
  `zapret`       INT NOT NULL DEFAULT 0,
  `status`       TINYINT NOT NULL DEFAULT 0,
  `arena_id`     INT NOT NULL DEFAULT 0,
  `komanda`      TINYINT NOT NULL DEFAULT 0,
  `boi_id`       INT NOT NULL DEFAULT 0,
  `pvp`          TINYINT NOT NULL DEFAULT 1,
  `pvpdate`      INT NOT NULL DEFAULT 0,
  `admin`        INT NOT NULL DEFAULT 0,
  `grafika`      TINYINT NOT NULL DEFAULT 1,
  `strelki`      TINYINT NOT NULL DEFAULT 1,
  `zdor`         INT NOT NULL DEFAULT 1,
  `sila`         INT NOT NULL DEFAULT 1,
  `lovka`        INT NOT NULL DEFAULT 1,
  `inta`         INT NOT NULL DEFAULT 1,
  `intel`        INT NOT NULL DEFAULT 1,
  `hpmax`        INT NOT NULL DEFAULT 10,
  `hpnow`        INT NOT NULL DEFAULT 10,
  `hptime`       INT NOT NULL DEFAULT 0,
  `manatime`     INT NOT NULL DEFAULT 0,
  `manamax`      INT NOT NULL DEFAULT 10,
  `mananow`      INT NOT NULL DEFAULT 10,
  `krit`         INT NOT NULL DEFAULT 10,
  `uvorot`       INT NOT NULL DEFAULT 10,
  `bron`         INT NOT NULL DEFAULT 1,
  `uron`         INT NOT NULL DEFAULT 1,
  `regdate`      INT NOT NULL DEFAULT 0,
  `lastdate`     INT NOT NULL DEFAULT 0,
  `newsdate`     INT NOT NULL DEFAULT 0,
  `chatdate`     INT NOT NULL DEFAULT 0,
  `chatroom`     INT NOT NULL DEFAULT 1,
  `exp`          INT NOT NULL DEFAULT 0,
  `rabota`       INT NOT NULL DEFAULT 0,
  `chest`        INT NOT NULL DEFAULT 0,
  `doping`       INT NOT NULL DEFAULT 0,
  `doping_time`  INT NOT NULL DEFAULT 0,
  `altar`        INT NOT NULL DEFAULT 0,
  `altar_time`   INT NOT NULL DEFAULT 0,
  `bonus_day`    INT NOT NULL DEFAULT 0,
  `bonus_time`   INT NOT NULL DEFAULT 0,
  `p_fishman`    INT NOT NULL DEFAULT 0,
  `fishrod`      INT NOT NULL DEFAULT 0,
  `kvest`        TEXT NOT NULL DEFAULT (''),
  `kvest_now`    INT NOT NULL DEFAULT 0,
  `kvest_step`   INT NOT NULL DEFAULT 0,
  `code`         VARCHAR(255) NOT NULL DEFAULT '',
  `autoreg`      TINYINT NOT NULL DEFAULT 0,
  `ref`          INT NOT NULL DEFAULT 1,
  PRIMARY KEY (`id`),
  KEY `idx_login` (`login`),
  KEY `idx_lastdate` (`lastdate`),
  KEY `idx_boi_id` (`boi_id`),
  KEY `idx_klan` (`klan`),
  KEY `idx_ip` (`ip`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ============================================================
--  Таблица: item — предметы
-- ============================================================
DROP TABLE IF EXISTS `item`;
CREATE TABLE `item` (
  `id`    INT NOT NULL AUTO_INCREMENT,
  `name`  VARCHAR(255) NOT NULL DEFAULT '',
  `lvl`   INT NOT NULL DEFAULT 0,
  `price` INT NOT NULL DEFAULT 0,
  `krit`  INT NOT NULL DEFAULT 0,
  `uvorot` INT NOT NULL DEFAULT 0,
  `uron`  INT NOT NULL DEFAULT 0,
  `bron`  INT NOT NULL DEFAULT 0,
  `hp`    INT NOT NULL DEFAULT 0,
  `zdor`  INT NOT NULL DEFAULT 1,
  `sila`  INT NOT NULL DEFAULT 0,
  `inta`  INT NOT NULL DEFAULT 0,
  `lovka` INT NOT NULL DEFAULT 0,
  `intel` INT NOT NULL DEFAULT 0,
  `art`   VARCHAR(50) NOT NULL DEFAULT '',
  `info`  TEXT NOT NULL DEFAULT (''),
  `equip` VARCHAR(50) NOT NULL DEFAULT '',
  PRIMARY KEY (`id`),
  KEY `idx_lvl` (`lvl`),
  KEY `idx_equip` (`equip`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

